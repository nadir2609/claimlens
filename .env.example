# Analysis provider. The first key that is set wins: Gemini, then Claude.
# Leave both empty to run in demo mode (simulated analysis).

# Google Gemini (free tier available): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (paid): create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Part prices come from ehtiyathisseleri.az and avtopro.az, which need no key.
# Firecrawl (optional): also tries rockauto.com and partsouq.com for parts the local sites do not list.
# Create a key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=

PORT=3001
