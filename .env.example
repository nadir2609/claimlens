# Analysis provider. The first key that is set wins: Gemini, then Claude.
# Leave both empty to run in demo mode (simulated analysis).

# Google Gemini (free tier available): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (paid): create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Firecrawl: reads part prices from rockauto.com and partsouq.com. Create a key at https://www.firecrawl.dev
# Leave empty to use the built-in fallback price table.
FIRECRAWL_API_KEY=

# eBay: fallback for parts the sites above do not stock (older or non-US cars, doors, glass).
# Create an app at https://developer.ebay.com and copy its Production App ID (Client ID) and Cert ID (Client Secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

PORT=3001
